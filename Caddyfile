{
	servers {
		protocols h1 h2
	}
}

{$PF_PUBLIC_DOMAIN} {
	header {
		?X-Frame-Options "DENY"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "no-referrer"
		-Server
		Strict-Transport-Security "max-age=86400"
	}

	@public path / /static /static/* /api/v1/*

	handle @public {
		request_body {
			max_size 1MB
		}

		reverse_proxy api:8000 {
			health_uri /readyz
			health_interval 10s
			health_timeout 2s

			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		respond 404
	}
}
