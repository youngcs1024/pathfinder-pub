# Safe offline defaults. Source this file explicitly if desired; the application
# does not load .env files automatically.
PF_LLM_MODE=fake
PF_SEARCH_MODE=fake
PF_AUTH_MODE=fake
# PF_SUPABASE_PROJECT_REF=your-project-ref
# Browser-public key; never use sb_secret_ or service_role here.
# PF_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# PF_SUPABASE_JWT_AUDIENCE=authenticated
PF_TRACE_MODE=off
PF_QWEN_CHAT_MODEL=qwen3.6-flash-2026-04-16
PF_QWEN_REASONING_EFFORT=medium
PF_QWEN_EMBEDDING_MODEL=text-embedding-v4
PF_QWEN_EMBEDDING_DIMENSION=1536
PF_LOG_LEVEL=INFO
# No real sources are enabled by default. Use a private JSON allowlist and
# read-only worker mount; see compose.materials.example.yaml.
# PF_MATERIAL_ALIASES_FILE=/run/pathfinder/material-aliases.json
PF_DATABASE_URL=postgresql+psycopg://pathfinder:pathfinder@127.0.0.1:5432/pathfinder
# Business and independent Checkpoint runtime connections use this policy.
# Runtime PF_DATABASE_URL must not contain options, even empty options.
# Milliseconds: statement/idle 1..300000, lock 1..30000 and strictly below statement.
PF_DB_STATEMENT_TIMEOUT_MS=5000
PF_DB_LOCK_TIMEOUT_MS=1000
PF_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# Seconds: connect integer 1..60; pool wait finite >0..60 (fractions allowed).
PF_DB_CONNECT_TIMEOUT_SECONDS=5
PF_DB_POOL_TIMEOUT_SECONDS=2
# Per business process: pool 1..20, overflow 0..20. Checkpoint is independent.
PF_DB_POOL_SIZE=5
PF_DB_MAX_OVERFLOW=0
# pre_ping stays true; application_name comes from a fixed component in code.
# Checkpoint setup: 30000 ms statement / 5000 ms lock; runtime policy before ready.
# Readiness retains its 1-second outer deadline; Compose healthchecks allow 2 seconds.
# API/worker each own a pool; also budget Checkpoint, CLI, probe and maintenance connections.
# PF_DB_* does not configure Alembic/pg_dump or PostgreSQL server logging.
# Database logs may contain SQL/body/parameters; see docs/runbook.md before private inspection.
PF_API_HOST=127.0.0.1
PF_MOCK_PORTAL_BASE_URL=http://127.0.0.1:8000

# Deployment-only Compose/release settings. Use a generated password and a matching
# PF_DATABASE_URL in the deployment environment; never commit their real values.
# PF_PUBLIC_DOMAIN=pathfinder.example.com
# PF_POSTGRES_PASSWORD=<generated-postgres-password>
# PF_DATABASE_URL=postgresql+psycopg://pathfinder:<url-encoded-password>@postgres:5432/pathfinder
# PATHFINDER_IMAGE=registry.example.com/pathfinder@sha256:<64-hex-digest>
# PF_RELEASE_BACKUP_DIR=/srv/pathfinder-backups

# Both values are required only when PF_LLM_MODE=qwen. The workspace must be in
# 华北2（北京） and the API key must belong to the same region. Never commit them.
# PF_QWEN_WORKSPACE_ID=
# DASHSCOPE_API_KEY=

# Required only when PF_SEARCH_MODE=tavily. Never commit a real value.
# TAVILY_API_KEY=

# All three values are required only when PF_TRACE_MODE=langfuse. Use the
# explicit official Cloud region that owns the project; never commit real keys.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Optional when tracing is enabled; accepted range is 0 through 1.
# LANGFUSE_SAMPLE_RATE=1.0
